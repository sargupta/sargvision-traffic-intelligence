worker_processes auto;
error_log /dev/stderr warn;
pid /tmp/nginx.pid;
events { worker_connections 1024; }

http {
  include       /etc/nginx/mime.types;
  default_type  application/octet-stream;
  access_log    /dev/stdout;

  sendfile        on;
  tcp_nopush      on;
  keepalive_timeout 65;
  server_tokens   off;

  # Cloud Run's container filesystem is read-only apart from /tmp.
  client_body_temp_path /tmp/client_temp;
  proxy_temp_path       /tmp/proxy_temp;
  fastcgi_temp_path     /tmp/fastcgi_temp;
  uwsgi_temp_path       /tmp/uwsgi_temp;
  scgi_temp_path        /tmp/scgi_temp;

  gzip              on;
  gzip_vary         on;
  gzip_comp_level   6;
  gzip_min_length   1024;
  gzip_types        text/plain text/css application/javascript application/json
                    image/svg+xml application/x-font-ttf font/woff2;

  server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    add_header X-Content-Type-Options    "nosniff"            always;
    add_header X-Frame-Options           "SAMEORIGIN"         always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy        "geolocation=(), microphone=(), camera=()" always;

    # Google Maps needs its own script, image and connect origins; nothing else
    # is permitted to load. Fonts are self-hosted by next/font, so no font CDN.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://maps.googleapis.com https://maps.gstatic.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.googleapis.com https://*.gstatic.com https://*.google.com https://*.ggpht.com; font-src 'self' data:; connect-src 'self' ${API_ORIGIN} https://maps.googleapis.com https://*.googleapis.com; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'" always;

    # Hashed build assets never change under the same name.
    location /_next/static/ {
      expires 1y;
      add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location /data/ {
      expires 1h;
      add_header Cache-Control "public, max-age=3600";
    }

    location = /healthz {
      access_log off;
      return 200 "ok\n";
      add_header Content-Type text/plain;
    }

    # Next's static export writes /console.html, not /console/index.html, so a
    # trailing slash misses every try_files branch and falls through to the SPA
    # fallback — serving the wrong page with a 200 and no clue anything is off.
    # The .+ (not .*) keeps "/" itself from matching and looping.
    rewrite ^/(.+)/$ /$1 permanent;

    location / {
      try_files $uri $uri.html $uri/index.html /index.html;
    }
  }
}
